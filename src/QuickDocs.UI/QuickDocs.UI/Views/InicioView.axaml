<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuickDocs.UI.ViewModels"
             xmlns:conv="using:QuickDocs.UI.Converters"
             xmlns:models="using:QuickDocs.Core.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="QuickDocs.UI.Views.InicioView"
             x:DataType="vm:InicioViewModel">

    <UserControl.Resources>
        <conv:MontoTextoConverter x:Key="MontoTextoConverter"/>
        <conv:MontoColorConverter x:Key="MontoColorConverter"/>
        <conv:VencimientoTextoConverter x:Key="VencimientoTextoConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="20">

            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Bienvenido a QuickDocs" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Este es el estado actual de tu gestión comercial." FontSize="13" Foreground="#64748B"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#E2E8F0" Padding="12,8" CornerRadius="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📅" FontFamily="Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:dd \'de\' MMMM}'}"
                                FontWeight="Medium"
                                Foreground="#334155"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15">

                <Border Grid.Column="0" Background="White" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="#E2E8F0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Clientes registrados" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CantidadClientes}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="#E2E8F0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Documentos este mes" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding DocumentosEsteMes}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="#E2E8F0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Presupuestos pendientes" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding PresupuestosPendientes}" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

            </Grid>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                <Border Grid.Column="0" Background="White" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="#E2E8F0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Últimos documentos generados" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding UltimosDocumentos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Documento">
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,6">
                                        <Border Grid.Column="0" Background="#E0F2FE" Width="32" Height="32" CornerRadius="16">
                                            <TextBlock Text="📄" FontFamily="Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NumeroFormateado}" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                                            <TextBlock Text="{Binding ClienteNombre}" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                    Text="{Binding Converter={StaticResource MontoTextoConverter}}"
                                                    Foreground="{Binding Converter={StaticResource MontoColorConverter}}"
                                                    FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding UltimosDocumentos.Count, StringFormat='No hay documentos generados todavía.'}"
                                   IsVisible="{Binding !UltimosDocumentos.Count}"
                                   Foreground="#94A3B8" FontSize="12" Margin="0,4"/>

                        <Button Command="{Binding VerHistorialCommand}"
                                Background="Transparent" Padding="0" Margin="0,8,0,0"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Ver historial completo" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="→" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="#E2E8F0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Próximos a vencer" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding ProximosAVencer}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Documento">
                                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,6">
                                        <Border Grid.Column="0" Background="#FEE2E2" Width="32" Height="32" CornerRadius="16">
                                            <TextBlock Text="⚠️" FontFamily="Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NumeroFormateado}" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                                            <TextBlock Text="{Binding ClienteNombre}" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                    Text="{Binding Converter={StaticResource VencimientoTextoConverter}}"
                                                    Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No hay documentos próximos a vencer."
                                   IsVisible="{Binding !ProximosAVencer.Count}"
                                   Foreground="#94A3B8" FontSize="12" Margin="0,4"/>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>